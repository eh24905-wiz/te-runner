    account = _norm_account(_flag(args, "--account-id") or die(2, "instance inspect needs --account-id"))
    rtype = _flag(args, "--type") or "VIRTUAL_MACHINE"
    data, _ = api(INSTANCES, {"f": {"subscriptionExternalId": [account], "type": [rtype]}})
    n = (data.get("cloudResources") or {}).get("totalCount") or 0
    print(f"instance inspect: {n} {rtype} scanned in account {account}")
