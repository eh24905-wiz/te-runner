def _sensor_name(args):
    # The installed sensor's name == the host name, which a lab pins to the session stem. So the stem
    # is the sensor's scoping key; --name overrides for a manual/dev run.
    return _flag(args, "--name") or _lab_stem(_session_id(args))


def _sa_name(args):
    return _flag(args, "--name") or f"{_lab_stem(_session_id(args))}-sensor"


def _resolve_sensor(name):
    """The sensor whose name exactly matches, ACTIVE-first (search is substring, so filter to ==)."""
    data, _ = api(SENSORS_Q, {"s": name})
    nodes = [n for n in ((data.get("sensors") or {}).get("nodes") or []) if n.get("name") == name]
    return sorted(nodes, key=lambda n: n.get("status") != "ACTIVE")[0] if nodes else None


def _find_sa(name):
    """The service account whose name matches exactly (the filter is substring, so filter to ==)."""
    data, _ = api(SA_FIND, {"n": name})
    return next((n for n in ((data.get("serviceAccounts") or {}).get("nodes") or []) if n.get("name") == name), None)


def _ensure_sa(name, sa_type, scopes, id_var, secret_var, label):
    """Create a service account named on the session stem so the reaper sweeps it, parameterized over
    type + scopes (SENSOR takes none; a CLI account takes create:security_scans etc.). Idempotent by
    name: the client secret is shown once and is not re-fetchable, so a re-run reports the existing
    account rather than minting a duplicate. Emits <id_var>/<secret_var> to stdout and $EXEC_OUTPUT.
    Solve/setup only — never a learner check (it prints a secret)."""
    if _find_sa(name):
        print(f"service account {name} already exists; secret not re-fetchable", file=sys.stderr)
        sys.exit(0)
    inp = {"name": name, "type": sa_type}
    if scopes:
        inp["scopes"] = scopes
    data, _ = api(CREATE_SA, {"input": inp})
    sa = (data.get("createServiceAccount") or {}).get("serviceAccount") or {}
    cid, sec = sa.get("clientId"), sa.get("clientSecret")
    if not cid or not sec:
        die(3, "createServiceAccount returned no client credentials")
    lines = f"{id_var}={cid}\n{secret_var}={sec}\n"
    sys.stdout.write(lines)
    out = os.getenv("EXEC_OUTPUT")
    if out:
        with open(out, "a") as f:
            f.write(lines)
    print(f"created {label} service account {name} ({sa['id']})", file=sys.stderr)
    sys.exit(0)


def _delete_sa(args, name):
    """Delete a service account by --id or (default) the given session-stem name. The reaper's prefix
    sweep already covers ServiceAccount, so this is for a solve/explicit teardown."""
    sid = _flag(args, "--id")
    if not sid:
        node = _find_sa(name)
        if not node:
            print(f"no service account named {name}; nothing to delete")
            sys.exit(0)
        sid = node["id"]
    api('mutation { deleteServiceAccount(input: { id: "' + sid + '" }) { _stub } }', {})
    print(f"deleted service account {sid}")
    sys.exit(0)


def cmd_sensor_ensure(args):
    """Mint the type:SENSOR service account the Runtime Sensor authenticates with, emitting
    WIZ_API_CLIENT_ID / WIZ_API_CLIENT_SECRET (the install one-liner's own variable names). See
    _ensure_sa for the shared idempotency + emit contract."""
    _ensure_sa(_sa_name(args), "SENSOR", None, "WIZ_API_CLIENT_ID", "WIZ_API_CLIENT_SECRET", "sensor")


def cmd_sensor_delete(args):
    """Delete the sensor service account (see _delete_sa)."""
    _delete_sa(args, _sa_name(args))


def cmd_sensor_inspect(args):
    """Assert the session's sensor is known to Wiz (--require exists) or reports Active (--require
    active). SensorStatus is ACTIVE/INACTIVE only; a pre-Active sensor reads INACTIVE or is absent."""
    name = _sensor_name(args)
    require = _flag(args, "--require") or "exists"
    if require not in ("exists", "active"):
        die(2, f"--require must be exists|active, got {require}")
    node = _resolve_sensor(name)
    if not node:
        print(f"no sensor named {name}")
        sys.exit(1)
    print(f"sensor {node['name']} ({node['id']}): status={node['status']} type={node['type']}")
    if require == "exists":
        sys.exit(0)
    sys.exit(0 if node["status"] == "ACTIVE" else 1)


def cmd_detection_inspect(args):
    """Assert >=1 detection for --rule-name on the session's sensor. Default type GENERATED_THREAT;
    --match-only queries the MATCH_ONLY side (the rule that matched and raised no threat). Keyed on
    matchedRuleName + type + the resolved sensorId — never a rule id (tenant-specific) and never an
    Issue/Threat object (tenant-wide anti-burst cap)."""
    name = _sensor_name(args)
    rule = _flag(args, "--rule-name") or die(2, "detection inspect needs --rule-name")
    dtype = "MATCH_ONLY" if "--match-only" in args else "GENERATED_THREAT"
    minutes = int(_flag(args, "--since-minutes") or "120")
    node = _resolve_sensor(name)
    if not node:
        print(f"no sensor named {name}; cannot scope detections")
        sys.exit(1)
    f = {
        "sensorId": {"equals": [node["id"]]},
        "matchedRuleName": {"equals": [rule]},
        "type": {"equals": [dtype]},
        "startedAt": {"inLast": {"amount": minutes, "unit": "DurationFilterValueUnitMinutes"}},
    }
    data, _ = api(DETECTIONS_Q, {"f": f})
    n = (data.get("detections") or {}).get("totalCount") or 0
    print(f"detection inspect: {n} {dtype} for rule {rule!r} on sensor {name} ({node['id']})")
    sys.exit(0 if n > 0 else 1)


# --- Wiz CLI credential for `wizcli auth`, minted via a CLI DEPLOYMENT (not createServiceAccount:
# type:CLI accounts are internal and that mutation rejects them). createCliDeployment returns the
# client secret ONCE, so `ensure` converges to one fresh deployment (delete-then-mint, like the
# sensor). The SA it creates is named "<deployment-name>-deployment-<uuid>", so the reaper's
# ServiceAccount lab-<id>* prefix sweep still catches it; `delete` removes the deployment itself. ---
CLI_DEPLOYMENTS_Q = """query CliDeployments($f: DeploymentFilters) {
  deployments(first: 50, filterBy: $f) { nodes { id name type } }
}"""

CREATE_CLI_DEPLOYMENT = """mutation CreateCliDeployment($input: CreateCliDeploymentInput!) {
  createCliDeployment(input: $input) {
    clientSecret
    deployment { id name type object { ... on WizCLI { serviceAccount { name clientId } } } }
  }
}"""


def _cli_dep_name(args):
    return _flag(args, "--name") or f"{_lab_stem(_session_id(args))}-cli"


def _find_cli_deployment(name):
    """The WIZ_CLI deployment whose name matches exactly (search is substring, so filter to ==)."""
    data, _ = api(CLI_DEPLOYMENTS_Q, {"f": {"type": ["WIZ_CLI"], "search": name}})
    return next((n for n in ((data.get("deployments") or {}).get("nodes") or []) if n.get("name") == name), None)


def _delete_cli_deployment(dep_id):
    api('mutation { deleteCliDeployment(input: { id: "' + dep_id + '" }) { id } }', {})


def cmd_serviceaccount_ensure(args):
    """Mint the on-the-fly wizcli credential via a CLI deployment, emitting WIZ_CLIENT_ID /
    WIZ_CLIENT_SECRET (wizcli's own env-var names) to stdout and $EXEC_OUTPUT. The client secret is
    shown once, so this converges to ONE fresh deployment: any existing one on this name is deleted
    first, then a fresh one created. Solve/setup only — never a learner check (it prints a secret)."""
    name = _cli_dep_name(args)
    existing = _find_cli_deployment(name)
    if existing:
        _delete_cli_deployment(existing["id"])
    data, _ = api(CREATE_CLI_DEPLOYMENT, {"input": {"name": name, "projectIDs": [], "expiresAt": None}})
    payload = data.get("createCliDeployment") or {}
    dep = payload.get("deployment") or {}
    sa = (dep.get("object") or {}).get("serviceAccount") or {}
    cid, sec = sa.get("clientId"), payload.get("clientSecret")
    if not cid or not sec:
        die(3, "createCliDeployment returned no client credentials")
    lines = f"WIZ_CLIENT_ID={cid}\nWIZ_CLIENT_SECRET={sec}\n"
    sys.stdout.write(lines)
    out = os.getenv("EXEC_OUTPUT")
    if out:
        with open(out, "a") as f:
            f.write(lines)
    print(f"created wiz cli deployment {name} ({dep.get('id')})", file=sys.stderr)
    sys.exit(0)


def cmd_serviceaccount_inspect(args):
    """Assert the session's Wiz CLI deployment exists (--require exists)."""
    require = _flag(args, "--require") or "exists"
    if require != "exists":
        die(2, f"--require must be exists, got {require}")
    name = _cli_dep_name(args)
    node = _find_cli_deployment(name)
    if not node:
        print(f"no wiz cli deployment named {name}")
        sys.exit(1)
    print(f"wiz cli deployment {node['name']} ({node['id']})")
    sys.exit(0)


def cmd_serviceaccount_delete(args):
    """Delete the session's Wiz CLI deployment, by --id or (default) the session-stem name. The
    reaper's ServiceAccount prefix sweep also catches the SA the deployment created."""
    dep_id = _flag(args, "--id")
    if not dep_id:
        name = _cli_dep_name(args)
        node = _find_cli_deployment(name)
        if not node:
            print(f"no wiz cli deployment named {name}; nothing to delete")
            sys.exit(0)
        dep_id = node["id"]
    _delete_cli_deployment(dep_id)
    print(f"deleted wiz cli deployment {dep_id}")
    sys.exit(0)


# --- Wiz Code CI/CD scan, published by `wizcli scan dir --tags session=<stem>`. A learner check must
# grade the tenant-side scan, not the CLI exit code: WARN_BY_POLICY exits 0, so only the published
# verdict tells a blocking finding from a pass. Scoped by the session tag; the latest scan wins.
# Publish latency is unmeasured, so --require polls to --timeout. ---
_TAG_OK = re.compile(r"^[A-Za-z0-9._-]+$")


def _cicd_latest(tag_key, tag_value):
    """The most recent CICDScan carrying tag key=value. Inlined (not a typed variable) so a wrong
    input-type name can't error the query; the tag is validated to a safe charset first."""
    if not (_TAG_OK.match(tag_key) and _TAG_OK.match(tag_value)):
        die(2, "code-scan tag key/value must match [A-Za-z0-9._-]+")
    qy = (
        'query { cicdScans(first: 5, filterBy: { tag: { key: "' + tag_key + '", value: "' + tag_value + '" } }, '
        "orderBy: { field: CREATED_AT, direction: DESC }) "
        "{ nodes { id status { state verdict } } totalCount } }"
    )
    data, _ = api(qy, {})
    nodes = (data.get("cicdScans") or {}).get("nodes") or []
    return nodes[0] if nodes else None


def cmd_codescan_inspect(args):
    """Assert a Wiz CLI scan for this session. --require published (>=1 scan tagged session=<stem>) or
    pass (latest scan verdict PASSED_BY_POLICY). Polls every --interval up to --timeout (default 180s)
    because publish latency is unmeasured; a definitive FAILED_BY_POLICY exits 1 without waiting."""
    require = _flag(args, "--require") or "published"
    if require not in ("published", "pass"):
        die(2, f"--require must be published|pass, got {require}")
    tag_key = _flag(args, "--tag-key") or "session"
    tag_value = _flag(args, "--tag-value") or _lab_stem(_session_id(args))
    timeout = int(_flag(args, "--timeout") or "180")
    interval = int(_flag(args, "--interval") or "10")
    deadline = time.monotonic() + timeout
    while True:
        node = _cicd_latest(tag_key, tag_value)
        if node:
            st = node.get("status") or {}
            state, verdict = st.get("state"), st.get("verdict")
            if require == "published":
                print(f"code-scan: {node['id']} present ({tag_key}={tag_value}) state={state} verdict={verdict}")
                sys.exit(0)
            if verdict == "PASSED_BY_POLICY":
                print(f"code-scan: {node['id']} PASSED_BY_POLICY")
                sys.exit(0)
            if verdict == "FAILED_BY_POLICY":
                print(f"code-scan: {node['id']} FAILED_BY_POLICY")
                sys.exit(1)
            # verdict not yet set (scan still running) — keep polling
        if time.monotonic() >= deadline:
            waited = "passing " if require == "pass" else ""
            print(f"code-scan: no {waited}scan for {tag_key}={tag_value} within {timeout}s")
            sys.exit(1)
        time.sleep(interval)


# --- Wiz Code CI/CD scan policy: the BLOCK gate a code-scan lab's `wizcli scan dir --policies <name>`
# trips. A SHARED, PERSISTENT fixture (not session-scoped) so the reaper never deletes it. Scoped to
# one builtin Dockerfile control so it never blocks unrelated scans, and default:false so only a scan
# that names it is gated. ---
CICD_POLICIES_Q = """query CicdPolicies($f: CICDScanPolicyFilters) {
  cicdScanPolicies(first: 50, filterBy: $f) { nodes { id name } }
}"""

CREATE_CICD_POLICY = """mutation CreateCicdPolicy($input: CreateCICDScanPolicyInput!) {
  createCICDScanPolicy(input: $input) { scanPolicy { id name } }
}"""

CONFIG_RULE_Q = """query ConfigRule($f: CloudConfigurationRuleFilters) {
  cloudConfigurationRules(first: 5, filterBy: $f) { nodes { id name severity } }
}"""

ROOT_DOCKERFILE_CONTROL = "Last User Is 'root'"  # builtin, HIGH, matcher DOCKER_FILE


def _policy_name(args):
    return _flag(args, "--name") or die(2, "policy needs --name <policy-name>")


def _find_policy(name):
    """The IaC CI/CD scan policy whose name matches exactly (names filter is a contains, so ==)."""
    data, _ = api(CICD_POLICIES_Q, {"f": {"type": ["IAC"], "names": [name]}})
    return next((n for n in ((data.get("cicdScanPolicies") or {}).get("nodes") or []) if n.get("name") == name), None)


def _resolve_dockerfile_control(search):
    """Resolve the builtin Dockerfile control live — its id is tenant-specific, never hard-coded. The
    name must match EXACTLY and once: `search` is a server-side contains, so its first hit can be a
    different control, scoping the policy to a condition the lab never asks the learner to fix.
    `--rule-id` is the way to scope to anything else."""
    data, _ = api(CONFIG_RULE_Q, {"f": {"search": search, "matcherType": ["DOCKER_FILE"]}})
    nodes = (data.get("cloudConfigurationRules") or {}).get("nodes") or []
    exact = [n for n in nodes if n.get("name") == ROOT_DOCKERFILE_CONTROL]
    if len(exact) > 1:
        die(3, f"tenant holds {len(exact)} DOCKER_FILE controls named {ROOT_DOCKERFILE_CONTROL!r}; "
               f"pass --rule-id to name the one to scope to")
    return exact[0] if exact else None


def cmd_policy_ensure(args):
    """Ensure the BLOCK CI/CD IaC scan policy named --name exists (idempotent by name). Scoped to the
    builtin Dockerfile control 'Last User Is root' so `wizcli scan dir --policies <name>` FAILS
    (exit 4) on a root Dockerfile and passes once fixed. Shared, persistent fixture — the reaper never
    deletes it. --severity / --count-threshold override the defaults; --rule-id scopes to a different
    control outright, while --control-search only narrows the lookup for the documented one."""
    name = _policy_name(args)
    existing = _find_policy(name)
    if existing:
        print(f"cicd scan policy {name} exists ({existing['id']})")
        sys.exit(0)
    rule_id = _flag(args, "--rule-id")
    if not rule_id:
        ctl = _resolve_dockerfile_control(_flag(args, "--control-search") or "Last User Is")
        if not ctl:
            die(3, f"no DOCKER_FILE control matching {ROOT_DOCKERFILE_CONTROL!r} in this tenant")
        rule_id = ctl["id"]
    inp = {
        "name": name,
        "default": False,
        "lifecycleTargets": ["DEPLOY", "BUILD", "CODE"],
        "policyLifecycleEnforcements": [{"enforcementMethod": "BLOCK", "deploymentLifecycle": "CLI"}],
        # countThreshold must be positive (0 is rejected live). 1 fails on the first HIGH hit from the
        # scoped control; scoping to the one control means no unrelated IaC finding trips it.
        "iacParams": {
            "severityThreshold": _flag(args, "--severity") or "HIGH",
            "countThreshold": int(_flag(args, "--count-threshold") or "1"),
            "cloudConfigurationRules": [rule_id],
        },
    }
    data, _ = api(CREATE_CICD_POLICY, {"input": inp})
    pol = (data.get("createCICDScanPolicy") or {}).get("scanPolicy") or {}
    if not pol.get("id"):
        die(3, "createCICDScanPolicy returned no policy id")
    print(f"created cicd scan policy {name} ({pol['id']}) scoped to control {rule_id}")
    sys.exit(0)


def cmd_policy_inspect(args):
    """Assert the CI/CD scan policy named --name exists (--require exists) — setup verification."""
    require = _flag(args, "--require") or "exists"
    if require != "exists":
        die(2, f"--require must be exists, got {require}")
    name = _policy_name(args)
