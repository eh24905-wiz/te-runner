#!/usr/bin/env python3
"""wizlab: the TE lab runtime. Owns every Wiz fact; content decides which fact means success.

Exit codes are the contract (te-labkit-v2/PRD.md rock 1):
  0 condition satisfied | 1 learner state not satisfied | 2 invocation error | 3 environment error

In learner-facing check scripts, never let 2/3 reach the platform: an exit code outside the
declared success/failure lists lands in a terminal validating_error state that bricks the
session (probe-verified 2026-08-28). Wrap: `wizlab ... ; case $? in 0) exit 0;; *) exit 1;; esac`
with the env-health check as its own leading `check` block. In CI, consume 2/3 directly.

Queries and auth are mined from te-labkit/bricks/connector.py (proven on live leases), not invented.
"""

import json
import os
import re
import secrets
import string
import subprocess
import sys
import time
import urllib.parse
import urllib.request

AUTH_URL = "https://auth.app.wiz.io/oauth/token"

# The delegator ARN is per-tenant and its `prod-<dc>` segment varies by data center, so it is never
# a constant — resolved live from managedIdentityParameters.aws.roleArn (v1 connector.py:934).
IDENTITY = """query ManagedIdentityParameters {
  managedIdentityParameters { aws { roleArn defaultEnvironment } }
}"""
_DELEGATOR_RE = re.compile(r"role/prod-[A-Za-z0-9_-]+-AssumeRoleDelegator", re.IGNORECASE)
ROLE_NAME = "WizAccess-Role"
HEALTHY_STATUSES = {"CONNECTED"}  # measured terminal state; INITIAL_SCANNING is transient, ERROR is failure

FIND = """query FindConnector($ids: [String!]) {
  connectors(filterBy: { cloudAccountExternalId: $ids }, first: 10) {
    nodes {
      id name enabled status
      type { id }
      config {
        ... on ConnectorConfigAWS { customerRoleARN externalIdNonce }
        ... on ConnectorConfigGCP { projectId: project_id }
        ... on ConnectorConfigAzure { subscriptionId tenantId isManagedIdentity }
      }
    }
    totalCount
  }
}"""

BY_TYPE = """query ConnectorsByType($t: [String!]) {
  connectors(filterBy: { connectorType: $t }, first: 100) {
    nodes {
      id name enabled status
      type { id }
      config {
        ... on ConnectorConfigAWS { customerRoleARN externalIdNonce }
        ... on ConnectorConfigGCP { projectId: project_id }
        ... on ConnectorConfigAzure { subscriptionId tenantId isManagedIdentity }
      }
    }
    totalCount
  }
}"""

CREATE = """mutation CreateConnector($input: CreateConnectorInput!) {
  createConnector(input: $input) { connector { id name status } }
}"""

DELETE = """mutation DeleteConnector($input: DeleteConnectorInput!) {
  deleteConnector(input: $input) { _stub }
}"""

UPDATE = """mutation UpdateConnector($input: UpdateConnectorInput!) {
  updateConnector(input: $input) { connector { id name status } }
}"""

# Inventory presence check: a scanned cloud resource of a type, filtered to the lease account.
# subscriptionExternalId is the CSP account number (measured on TS_PROD); type is the Wiz graph type.
INSTANCES = """query Instances($f: CloudResourceFilters) {
  cloudResources(first: 1, filterBy: $f) { totalCount }
}"""

# Schema-explorer spike: find the audit-log/activity query that could drive a reaper, and drill into
# its return type. Kept as general Wiz API exploration, not throwaway.
INTROSPECT_QUERIES = """query { __schema { queryType { fields {
  name
  args { name }
  type { kind name ofType { kind name ofType { kind name ofType { kind name } } } }
} } } }"""

# __type is inlined (Wiz's gateway won't bind $variables on introspection; normal queries bind fine).
INTROSPECT_TYPE = ('query { __type(name: "%s") { fields { name type { kind name ofType '
                   '{ kind name ofType { kind name } } } } inputFields { name } enumValues { name } } }')


def die(code, msg):
    print(f"wizlab: {msg}", file=sys.stderr)
    sys.exit(code)


def _claims(tok):
    pad = tok.split(".")[1]
    pad += "=" * (-len(pad) % 4)
    import base64

    return json.loads(base64.urlsafe_b64decode(pad))


def _post(url, data, headers, attempts=3):
    # Retry transient failures (transport + 5xx/429) with backoff so a momentary Wiz blip doesn't
    # exit 3 and abort a fail-loud setup. 4xx (auth/bad request) is not transient — fail fast.
    payload = data.encode() if isinstance(data, str) else json.dumps(data).encode()
    last = ""
    for i in range(attempts):
        req = urllib.request.Request(url, data=payload, headers=headers)  # fresh per attempt
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                return json.loads(r.read())
        except urllib.error.HTTPError as e:
            body = e.read().decode(errors="replace")[:500]
            if e.code < 500 and e.code != 429:
                die(3, f"HTTP {e.code} from {url}: {body}")
            last = f"HTTP {e.code} from {url}: {body}"
        except Exception as e:
            last = f"transport failure to {url}: {type(e).__name__}: {e}"
        if i < attempts - 1:
            time.sleep(2**i)  # 1s, 2s
    die(3, f"after {attempts} attempts: {last}")


def token_and_dc():
    tenant = os.getenv("WIZ_TENANT", "TBCMP")
    cid = os.getenv(f"WIZ_{tenant}_CLIENT_ID") or os.getenv("WIZ_CLIENT_ID")
    sec = os.getenv(f"WIZ_{tenant}_CLIENT_SECRET") or os.getenv("WIZ_CLIENT_SECRET")
    if not cid or not sec:
        die(3, f"WIZ_{tenant}_CLIENT_ID / _CLIENT_SECRET not in environment")
    payload = urllib.parse.urlencode(
        {
            "grant_type": "client_credentials",
            "audience": "wiz-api",
            "client_id": cid,
            "client_secret": sec,
        }
    )
    res = _post(AUTH_URL, payload, {"Content-Type": "application/x-www-form-urlencoded"})
    tok = res.get("access_token")
    if not tok:
        die(3, f"no token returned: {res.get('message') or res}")
    claims = _claims(tok)
    return tok, claims["dc"], claims.get("tid")


def api(query, variables):
    tok, dc, tid = token_and_dc()
    res = _post(
        f"https://api.{dc}.app.wiz.io/graphql",
        {"query": query, "variables": variables},
        {"Content-Type": "application/json", "Authorization": f"Bearer {tok}"},
    )
    errors = res.get("errors") or []
    data = res.get("data")
    if errors and not any((data or {}).get(k) is not None for k in (data or {})):
        die(3, "; ".join(e.get("message", "?") for e in errors))
    return data or {}, tid


def _targets(node, account_id):
    if not account_id:  # empty id would make ":{}:" == "::" match any ARN — never match nothing
        return False
    cfg = node.get("config") or {}
    if cfg.get("projectId") == account_id or cfg.get("subscriptionId") == account_id:
        return True
    arn = cfg.get("customerRoleARN") or ""
    return f":{account_id}:" in arn


def _parents(nodes, cloud):
    """Cloud connectors, not the child deployments Wiz auto-spawns (e.g. `ECR in <acct>`,
    type.id=ecr) nor the builtin self-hosted pseudo-connector. Confirmed against TBCMP via
    the GUI deployments query: our connector is type.id=aws, its child ECR is type.id=ecr."""
    return [n for n in nodes if (n.get("type") or {}).get("id") == cloud]


def find_connector(account_id, cloud="aws"):
    """Connectors whose OWN config targets the account, active-first.

    Two lookups (ported from te-labkit connector.py:97, live-measured). cloudAccountExternalId
    filters on the account LINK, which Wiz creates 1-2 min AFTER the connector, so a check run
    right after create/onboarding won't match yet. The BY_TYPE fallback matches on the connector's
    own customerRoleARN and doesn't depend on the link. Gate it on finding no PARENT, never on no
    nodes: Wiz attaches a builtin pseudo-connector to every account, so "no nodes" never occurs and
    would silently retire the fallback — the exact bug that made delete miss a 3s-old connector.
    Known gap: BY_TYPE caps at first:100, so in a tenant with >100 aws connectors a brand-new one
    could be missed during the pre-link window; acceptable until measured to bite (v1 shipped 100)."""
    data, _ = api(FIND, {"ids": [account_id]})
    parents = _parents(((data.get("connectors") or {}).get("nodes")) or [], cloud)
    if not parents:
        data, _ = api(BY_TYPE, {"t": [cloud]})
        nodes = [n for n in (((data.get("connectors") or {}).get("nodes")) or []) if _targets(n, account_id)]
        parents = _parents(nodes, cloud)
    # An active connector outweighs a stale ERROR one left on a recycled account.
    return sorted(parents, key=lambda n: not (n.get("enabled") and n.get("status") != "ERROR"))


def cmd_session_verify(args):
    _tok, dc, tid = token_and_dc()
    # `viewer` is not a Wiz root field (returns "Resource not found"); `connectors` is proven
    # (FIND uses it). This confirms the token is accepted by the API, not just minted by auth.
    api("query { connectors(first: 1) { totalCount } }", {})
    print(f"ok: authenticated to dc={dc} tenant={tid}")
    sys.exit(0)


def _typename(t):
    # Unwrap NON_NULL/LIST wrappers to the underlying named type.
    while t and not t.get("name") and t.get("ofType"):
        t = t["ofType"]
    return (t or {}).get("name") or "?"


def cmd_wiz_tenant(args):
    """Emit this tenant's connector facts as KEY=value, live from the Wiz API — no hardcoded
    per-tenant values. A script `eval`s stdout to feed a terraform apply (the Wiz connector-role
    module needs remote-arn + external-id). One call, one auth; grow it by adding keys (readers take
    only what they know). To $EXEC_OUTPUT too, for a note/HCL ref."""
    data, tid = api(IDENTITY, {})
    aws = ((data.get("managedIdentityParameters") or {}).get("aws")) or {}
    facts = {
        "WIZ_REMOTE_ARN": aws.get("roleArn") or "",     # the delegator Wiz assumes (per-tenant/dc)
        "WIZ_EXTERNAL_ID": tid or "",                    # tenant id == the role's sts:ExternalId
        "WIZ_AWS_ENV": aws.get("defaultEnvironment") or "",
    }
    if not facts["WIZ_REMOTE_ARN"]:
        die(3, "managedIdentityParameters.aws.roleArn is empty; no delegator to emit")
    if not facts["WIZ_EXTERNAL_ID"]:
        die(3, "no tenant id (tid) in token; cannot emit external-id")
    lines = "".join(f"{k}={v}\n" for k, v in facts.items() if v)
    sys.stdout.write(lines)
    out = os.getenv("EXEC_OUTPUT")
    if out:
        with open(out, "a") as f:
            f.write(lines)
    sys.exit(0)


def cmd_wiz_queries(args):
    """List top-level Wiz queries whose name matches any --match term (default: audit-relevant), with
    return type. Finds the audit-log/activity query a reaper could use to enumerate what a user made."""
    terms = (_flag(args, "--match") or "audit,activity,event,log,entit,delete").lower().split(",")
    data, _ = api(INTROSPECT_QUERIES, {})
    fields = ((data.get("__schema") or {}).get("queryType") or {}).get("fields") or []
    hits = [f for f in fields if any(t in f["name"].lower() for t in terms)]
    for f in sorted(hits, key=lambda f: f["name"]):
        argnames = ", ".join(a["name"] for a in (f.get("args") or []))
        print(f"{f['name']}({argnames}) -> {_typename(f.get('type'))}")
    print(f"# {len(hits)} match of {len(fields)} top-level queries", file=sys.stderr)
    sys.exit(0)


def cmd_wiz_type(args):
    """Print a Wiz type's fields / inputFields / enumValues (drill into a `wiz queries` return type)."""
    name = _flag(args, "--name") or die(2, "wiz type needs --name <TypeName>")
    if not name.isidentifier():
        die(2, "type name must be alphanumeric")
    data, _ = api(INTROSPECT_TYPE % name, {})
    t = data.get("__type")
    if not t:
        die(1, f"no such type: {name}")
    for f in t.get("fields") or []:
        print(f"{f['name']}: {_typename(f.get('type'))}")
    for f in t.get("inputFields") or []:
        print(f"(in) {f['name']}")
    for v in t.get("enumValues") or []:
        print(f"(enum) {v['name']}")
    sys.exit(0)


def _audit_page(filter_body, cursor):
    after = f', after: "{cursor}"' if cursor else ""
    qy = (
        "query { auditLogEntries(first: 100" + after + ", filterBy: { " + filter_body + " }) "
        "{ nodes { action actionType status timestamp performer { id name } } "
        "pageInfo { hasNextPage endCursor } } }"
    )
    data, _ = api(qy, {})
    return data.get("auditLogEntries") or {}


def cmd_audit_user(args):
    """Catch/backstop: list Wiz audit actions by the ephemeral lab user in a recent window. Enumerates
    everything a learner did (GUI creates included) — the reaper's detection layer. Default shows only
    MUTATION (state-changing); --all includes queries. Match by --email/--account, override --match."""
    match = _flag(args, "--match")
    email = _flag(args, "--email") or (None if match else _lab_user_email(args)[0])
    needle = (match or email).lower()
    minutes = int(_flag(args, "--last-min") or "120")
    include_all = "--all" in args
    scope = "" if include_all else "actionType: MUTATION, "
    fb = scope + f"timestamp: {{ inLast: {{ amount: {minutes}, unit: DurationFilterValueUnitMinutes }} }}"
    cursor, pages, hits = None, 0, 0
    while pages < 25:
        conn = _audit_page(fb, cursor)
        for n in conn.get("nodes") or []:
            p = n.get("performer") or {}
            if needle in f"{p.get('id', '')} {p.get('name', '')}".lower():
                hits += 1
                print(f"{n['timestamp']}  {n['actionType']:10} {n.get('status', ''):8} {n['action']}")
        pi = conn.get("pageInfo") or {}
        if not pi.get("hasNextPage"):
            break
        cursor, pages = pi.get("endCursor"), pages + 1
    kind = "ALL" if include_all else "MUTATION"
    print(f"# {hits} {kind} action(s) by {email or match} in last {minutes}m", file=sys.stderr)
    sys.exit(0)


def cmd_connector_inspect(args):
    account = _flag(args, "--account-id") or die(2, "connector inspect needs --account-id")
    require = _flag(args, "--require") or "exists"
    if require not in ("exists", "healthy"):
        die(2, f"--require must be exists|healthy, got {require}")
    matches = find_connector(account)
    if not matches:
        print(f"no connector targets {account}")
        sys.exit(1)
    node = matches[0]
    print(f"connector {node['name']} ({node['id']}): enabled={node['enabled']} status={node['status']}")
    if require == "exists":
        sys.exit(0)
    # healthy: measured role-first on TBCMP (measurements.yaml aws.connector) -- INITIAL_SCANNING for
    # ~2-3 min, then CONNECTED, never ERROR. Require CONNECTED, not merely not-ERROR: INITIAL_SCANNING
    # is the window before Wiz has actually assumed the role, so not-ERROR there is a false pass.
    sys.exit(0 if node["enabled"] and node["status"] in HEALTHY_STATUSES else 1)


def _lab_stem(account):
    # One naming convention for everything a lab creates or tells the learner to create:
    # lab-<account>. The account is lease-unique, so this prefix is a safe, actor-independent reap
    # key — a name-prefix sweep catches solve-created (service-account actor) and learner-created
    # alike, which audit-by-actor cannot. Override the leading token with WIZLAB_SESSION_PREFIX.
    return f"{os.getenv('WIZLAB_SESSION_PREFIX', 'lab')}-{account}"


def cmd_connector_ensure(args):
    """Idempotent converge: create the connector if absent, else correct its customerRoleARN if it
    drifted (this is also the repair path — a lab seeds a wrong ARN, `ensure` fixes it)."""
    account = _flag(args, "--account-id") or die(2, "connector ensure needs --account-id")
    role_arn = _flag(args, "--role-arn") or f"arn:aws:iam::{account}:role/{ROLE_NAME}"
    matches = find_connector(account)
    if matches:
        n = matches[0]
        cur = (n.get("config") or {}).get("customerRoleARN") or ""
        if cur == role_arn:
            print(f"connector {n['name']} already targets {account} with {role_arn}; nothing to do")
            sys.exit(0)
        api(UPDATE, {"input": {"id": n["id"], "patch": {"authParams": {"customerRoleARN": role_arn}}}})
        print(f"connector {n['name']}: customerRoleARN {cur or '(none)'} -> {role_arn}")
        sys.exit(0)
    name = f"{_lab_stem(account)}-connector"
    # Proven shape (v1 clouds/aws.py connector_payload): customerRoleARN goes in authParams,
    # NOT extraConfig; extraConfig carries only skipOrganizationScan. The role need not exist
    # yet — the connector sits in ERROR until task 2 deploys WizAccess-Role.
    data, _ = api(
        CREATE,
        {
            "input": {
                "name": name,
                "type": "aws",
                "authParams": {"customerRoleARN": role_arn},
                "extraConfig": {"skipOrganizationScan": True},
            }
        },
    )
    c = (data.get("createConnector") or {}).get("connector") or {}
    if not c:
        die(3, "createConnector returned no connector")
    print(f"created connector {c['name']} ({c['id']}) status={c['status']}")
    sys.exit(0)


def cmd_connector_delete(args):
    account = _flag(args, "--account-id") or die(2, "connector delete needs --account-id")
    matches = find_connector(account)
    if not matches:
        print(f"no connector targets {account}; nothing to delete")
        sys.exit(0)
    for n in matches:
        api(DELETE, {"input": {"id": n["id"]}})
        print(f"deleted connector {n['name']} ({n['id']})")
    sys.exit(0)


def cmd_instance_inspect(args):
    """Assert a scanned cloud resource of --type (default VIRTUAL_MACHINE) exists in Wiz for the
    account. Exit 0 if >=1 present, 1 if none — the 'is the EC2 scanned yet' check. Measured shape:
    cloudResources(filterBy subscriptionExternalId + type) on TS_PROD."""
    account = _flag(args, "--account-id") or die(2, "instance inspect needs --account-id")
    rtype = _flag(args, "--type") or "VIRTUAL_MACHINE"
    data, _ = api(INSTANCES, {"f": {"subscriptionExternalId": [account], "type": [rtype]}})
    n = (data.get("cloudResources") or {}).get("totalCount") or 0
    print(f"instance inspect: {n} {rtype} scanned in account {account}")
    sys.exit(0 if n > 0 else 1)


# --- role trust-policy helpers, ported from te-labkit clouds/aws.py (proven on live leases). IAM
# policy docs write plurals as scalar-or-list and hand back the trust doc either decoded or
# percent-encoded depending on the CLI build, so accept every shape or the assertion flickers. ---
def _as_list(v):
    if v is None:
        return []
    return list(v) if isinstance(v, (list, tuple)) else [v]


def _decode_trust_policy(doc):
    if isinstance(doc, dict):
        return doc
    if isinstance(doc, (str, bytes)):
        text = doc.decode("utf-8", "replace") if isinstance(doc, bytes) else doc
        for cand in (text, urllib.parse.unquote_plus(text), urllib.parse.unquote(text)):
            try:
                p = json.loads(cand)
            except Exception:
                continue
            if isinstance(p, dict):
                return p
    return None


def _grants_assume_role(stmt):
    if str(stmt.get("Effect", "")).strip().lower() != "allow":
        return False
    for a in _as_list(stmt.get("Action")):
        s = str(a).strip().lower()
        if s in ("*", "sts:*", "sts:assumerole") or (s.endswith("*") and "sts:assumerole".startswith(s[:-1])):
            return True
    return False


def _principals(stmt):
    pr = stmt.get("Principal")
    if isinstance(pr, str):
        return [pr]
    if isinstance(pr, dict):
        return [str(v) for vals in pr.values() for v in _as_list(vals)]
    return []


def _external_ids(stmt):
    # Only equality pins the value: a StringLike or Null condition would pass a role Wiz can't assume.
    cond = stmt.get("Condition") or {}
    if not isinstance(cond, dict):
        return []
    out = []
    for op, mp in cond.items():
        if "equals" not in str(op).lower() or not isinstance(mp, dict):
            continue
        for k, v in mp.items():
            if str(k).strip().lower() == "sts:externalid":
                out.extend(str(x) for x in _as_list(v))
    return out


def _wiz_delegator():
    data, tid = api(IDENTITY, {})
    arn = ((data.get("managedIdentityParameters") or {}).get("aws") or {}).get("roleArn") or ""
    return arn, tid


def _aws(*a):
    return subprocess.run(["aws", *a], capture_output=True, text=True, check=False)


def cmd_role_inspect(args):
    """Existence is NOT the assertion: a role that trusts nobody is exactly the state a learner
    reaches by creating the role and stopping, and it reports the same connector ERROR forever. So
    verify the trust policy too (v1 aws.py:129). Delegator+tid resolved live for an EXACT match —
    another data center's delegator looks almost identical and does not work."""
    role = _flag(args, "--role-name") or ROLE_NAME
    res = _aws("iam", "get-role", "--role-name", role, "--output", "json")
    if res.returncode != 0:
        s = res.stderr.lower()
        if any(t in s for t in ("invalidclienttokenid", "unrecognizedclienttokenid", "signaturedoesnotmatch")):
            die(3, f"AWS auth failure probing role {role}: {res.stderr.strip()}")
        print(f"role {role} not found")
        sys.exit(1)
    role_obj = json.loads(res.stdout or "{}").get("Role") or {}
    policy = _decode_trust_policy(role_obj.get("AssumeRolePolicyDocument"))
    if policy is None:
        print(f"role {role} exists but its trust policy could not be decoded")
        sys.exit(1)
    delegator, tid = _wiz_delegator()
    grants = [s for s in _as_list(policy.get("Statement")) if isinstance(s, dict) and _grants_assume_role(s)]
    if not grants:
        print(f"role {role}: trust policy grants no sts:AssumeRole (trusts nobody)")
        sys.exit(1)
    principals = [p for s in grants for p in _principals(s)]
    if delegator:
        if delegator not in principals:
            print(f"role {role}: does not trust this tenant's Wiz delegator {delegator}; trusts {principals}")
            sys.exit(1)
    elif not any(_DELEGATOR_RE.search(p) for p in principals):
        print(f"role {role}: trusts no Wiz AssumeRoleDelegator; trusts {principals}")
        sys.exit(1)
    ext = [v for s in grants for v in _external_ids(s)]
    if not ext:
        print(f"role {role}: no StringEquals sts:ExternalId condition; Wiz's assume-role is rejected")
        sys.exit(1)
    if tid and tid not in ext:
        print(f"role {role}: sts:ExternalId {ext} != tenant id {tid}")
        sys.exit(1)
    print(f"role {role}: trust valid (assume-role to {delegator or 'Wiz delegator'}, externalId={tid})")
    sys.exit(0)


def cmd_role_ensure(args):
    """Deploy WizAccess-Role's trust so Wiz can assume it. Trust-only by design: task 2's check
    verifies only the trust policy. Scan permissions (SecurityAudit / ViewOnlyAccess / inline) are
    task 3's need and unverified against TBCMP health — added when there's a live health signal."""
    role = _flag(args, "--role-name") or ROLE_NAME
    delegator, tid = _wiz_delegator()
    if not delegator:
        die(3, "managedIdentityParameters.aws.roleArn is empty; cannot build a trust policy")
    # --external-id overrides the correct tid: setup uses it to SEED a broken trust (repair labs);
    # the learner's fix / solve runs `role ensure` with no override and writes the correct tid.
    ext = _flag(args, "--external-id") or tid
    if not ext:
        die(3, "no tenant id (tid) in token and no --external-id; cannot set sts:ExternalId")
    trust = json.dumps(
        {
            "Version": "2012-10-17",
            "Statement": [
                {
                    "Effect": "Allow",
                    "Principal": {"AWS": delegator},
                    "Action": "sts:AssumeRole",
                    "Condition": {"StringEquals": {"sts:ExternalId": ext}},
                }
            ],
        }
    )
    res = _aws("iam", "create-role", "--role-name", role, "--assume-role-policy-document", trust, "--output", "json")
    if res.returncode == 0:
        print(f"role {role}: created, trusts {delegator} (externalId={ext})")
    elif "entityalreadyexists" in res.stderr.lower():
        upd = _aws("iam", "update-assume-role-policy", "--role-name", role, "--policy-document", trust)
        if upd.returncode != 0:
            die(3, f"update-assume-role-policy failed: {upd.stderr.strip()}")
        print(f"role {role}: trust updated, trusts {delegator} (externalId={ext})")
    else:
        die(3, f"create-role failed: {res.stderr.strip()}")
    sys.exit(0)


# --- lab user (Keycloak), ported from te-labkit keycloak/{auth,user}.py (proven; probe 2026-08-29
# reached realm wiz-labs, group global-contributor). requests -> stdlib urllib. Backs Wiz SSO for a
# learner. Realm/endpoint come from grader-only env, never hardcoded (probe found realm=wiz-labs). ---
def _kc_env():
    vals = {}
    for k in ("LAB_KEYCLOAK_ENDPOINT", "LAB_KEYCLOAK_REALM", "LAB_KEYCLOAK_ADMIN_USER", "LAB_KEYCLOAK_ADMIN_PWD"):
        v = os.getenv(k)
        if not v:
            die(3, f"{k} not in environment (grader-only Keycloak secret; not wired?)")
        vals[k] = v
    return (
        vals["LAB_KEYCLOAK_ENDPOINT"].rstrip("/"),
        vals["LAB_KEYCLOAK_REALM"],
        vals["LAB_KEYCLOAK_ADMIN_USER"],
        vals["LAB_KEYCLOAK_ADMIN_PWD"],
    )


def _kc_token(endpoint, admin_user, admin_pwd):
    res = _post(
        f"{endpoint}/realms/master/protocol/openid-connect/token",
        urllib.parse.urlencode(
            {"grant_type": "password", "client_id": "admin-cli", "username": admin_user, "password": admin_pwd}
        ),
        {"Content-Type": "application/x-www-form-urlencoded"},
    )
    tok = res.get("access_token")
    if not tok:
        die(3, "Keycloak admin token: no access_token returned")
    return tok


def _kc_call(method, url, token, body=None):
    headers = {"Authorization": f"Bearer {token}"}
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return r.status, r.read()
    except urllib.error.HTTPError as e:
        return e.code, e.read()
    except Exception as e:
        die(3, f"Keycloak transport failure to {url}: {type(e).__name__}: {e}")


def _kc_user_id(endpoint, realm, token, email):
    # `search` is a substring match: a prefix collision (bob@x vs bob@x.io) would return the wrong
    # learner and a group-join/DELETE would hit them, so filter to an exact username/email and refuse
    # to guess on >1 (v1 keycloak/user.py get_keycloak_user_id).
    q = urllib.parse.urlencode({"exact": "true", "briefRepresentation": "true", "search": email})
    status, body = _kc_call("GET", f"{endpoint}/admin/realms/{realm}/users?{q}", token)
    if status != 200:
        die(3, f"Keycloak user lookup HTTP {status}")
    exact = [u for u in json.loads(body or b"[]") if email in (u.get("username"), u.get("email"))]
    if len(exact) > 1:
        die(3, f"{len(exact)} Keycloak users exactly match {email}; refusing to guess")
    return exact[0]["id"] if exact else None


def _kc_group_id(endpoint, realm, token, group):
    q = urllib.parse.urlencode({"search": group, "exact": "true"})
    status, body = _kc_call("GET", f"{endpoint}/admin/realms/{realm}/groups?{q}", token)
    if status != 200:
        die(3, f"Keycloak group lookup HTTP {status}")
    groups = json.loads(body or b"[]")
    if not groups:
        die(3, f"Keycloak group '{group}' not found in realm '{realm}'")
    return groups[0]["id"]


def _gen_password(length=14):
    # upper+lower+digit guaranteed so it clears a typical Keycloak policy (v1 misc.generate_password).
    pool = string.ascii_uppercase + string.ascii_lowercase + string.digits
    chars = [
        secrets.choice(string.ascii_uppercase),
        secrets.choice(string.ascii_lowercase),
        secrets.choice(string.digits),
    ] + [secrets.choice(pool) for _ in range(length - 3)]
    secrets.SystemRandom().shuffle(chars)
    return "".join(chars)


def _lab_user_email(args):
    # Deterministic from the lease so `ensure` is idempotent and `delete` needs no stored state (v1
    # kept the name in an agent var, which 2.0 drops). AWS_ACCOUNT_ID is the lease-stable seed here.
    account = _flag(args, "--account") or os.getenv("AWS_ACCOUNT_ID")
    if not account:
        die(2, "user verbs need --account or AWS_ACCOUNT_ID (the lease-stable identity seed)")
    domain = _flag(args, "--domain") or "titra-labs.ai"
    stem = _lab_stem(account)
    return f"{stem}@{domain}", stem


# Per-tenant SSO constants that CANNOT be derived (v1 credentials_tab.py:52): the suffix Wiz appends
# to the tenant id in its Cognito domain, and the SSO app client id. The tenant id itself IS derived
# (JWT `tid`), so it is not stored here — one source, no drift.
_TENANT_SSO = {
    "TBCMP": {"cognito_suffix": "34dq", "client_id": "4lgopniht2g4j58sirh4kh5gtl"},
    "TE_TENANT": {"cognito_suffix": "o8cy", "client_id": "54snbgo7lek43ct9ph3coc5484"},
}
_COGNITO_REGION = "us-east-1"  # Wiz's own auth infrastructure, not the lab's cloud region.


def _wiz_login_url():
    """The tenant's IdP-initiated Cognito authorize URL, or None if it cannot be built.

    A `lab_*` Keycloak user CANNOT sign in at app.wiz.io — that renders a real login page the account
    fails against, and the learner blames their creds (v1 credentials_tab.py:47). Only this IdP-init
    URL routes them straight to the lab's Keycloak. Full-URL env overrides win so a track can pin it.
    """
    tenant = os.getenv("WIZ_TENANT", "TBCMP")
    override = os.getenv("WIZ_LOGIN_URL") or os.getenv(f"WIZ_{tenant}_LOGIN_URL")
    if override:
        return override
    sso = _TENANT_SSO.get(tenant)
    if not sso:
        return None
    _tok, _dc, tid = token_and_dc()
    if not tid:
        return None
    callback = urllib.parse.quote(f"https://auth.app.wiz.io/api/oidc/idp-init-callback/{tid}", safe="")
    return (
        f"https://{tid}-{sso['cognito_suffix']}.auth.{_COGNITO_REGION}.amazoncognito.com"
        f"/oauth2/authorize?response_type=code&identity_provider=Keycloak"
        f"&client_id={sso['client_id']}&redirect_uri={callback}"
    )


def _publish_user(email, pwd):
    # Instruqt 2.0 replaces 1.0 agent vars: an `exec` resource writes KEY=value to $EXEC_OUTPUT,
    # read as resource.exec.<name>.output.<KEY> and rendered into a `note` via Handlebars. When not
    # under exec (grader manual run / acceptance), print so a human can use the creds. The login URL is
    # NOT emitted here: it is a per-tenant constant, not per-learner, so labs pin it as a note literal
    # (regenerate with `wizlab user login-url`); emitting a new key here would deadlock note decode.
    out = os.getenv("EXEC_OUTPUT")
    if out:
        with open(out, "a") as f:
            f.write(f"WIZ_USER={email}\nWIZ_PWD={pwd}\n")
        print("published WIZ_USER/WIZ_PWD to $EXEC_OUTPUT")
    else:
        print(f"WIZ_USER={email}")
        print(f"WIZ_PWD={pwd}")


def cmd_user_ensure(args):
    """Create (or password-reset) the per-lease Keycloak user backing Wiz SSO, join it to the RBAC
    group, and publish WIZ_USER/WIZ_PWD. Reset on an existing user: Keycloak never returns the old
    password and the learner needs a working value."""
    endpoint, realm, admin_user, admin_pwd = _kc_env()
    email, name = _lab_user_email(args)
    group = _flag(args, "--group") or "global-contributor"
    token = _kc_token(endpoint, admin_user, admin_pwd)
    pwd = _gen_password()
    uid = _kc_user_id(endpoint, realm, token, email)
    if uid is None:
        status, body = _kc_call(
            "POST",
            f"{endpoint}/admin/realms/{realm}/users",
            token,
            {
                "email": email,
                "username": email,
                "firstName": name,
                "lastName": "Student",
                "emailVerified": True,
                "enabled": True,
                "requiredActions": [],
                "credentials": [{"type": "password", "value": pwd, "temporary": False}],
            },
        )
        if status != 201:
            die(3, f"create user HTTP {status}: {body[:300]!r}")
        uid = _kc_user_id(endpoint, realm, token, email)
        action = "created"
    else:
        status, body = _kc_call(
            "PUT",
            f"{endpoint}/admin/realms/{realm}/users/{uid}/reset-password",
            token,
            {"type": "password", "value": pwd, "temporary": False},
        )
        if status not in (200, 204):
            die(3, f"reset-password HTTP {status}: {body[:300]!r}")
        action = "reset"
    gid = _kc_group_id(endpoint, realm, token, group)
    status, body = _kc_call("PUT", f"{endpoint}/admin/realms/{realm}/users/{uid}/groups/{gid}", token)
    if status not in (200, 204):
        die(3, f"group-join HTTP {status}: {body[:300]!r}")
    _publish_user(email, pwd)
    print(f"user {action}: {email} (group {group})")
    sys.exit(0)


def cmd_user_inspect(args):
    endpoint, realm, admin_user, admin_pwd = _kc_env()
    email, _ = _lab_user_email(args)
    group = _flag(args, "--group") or "global-contributor"
    token = _kc_token(endpoint, admin_user, admin_pwd)
    uid = _kc_user_id(endpoint, realm, token, email)
    if uid is None:
        print(f"no Keycloak user {email}")
        sys.exit(1)
    status, body = _kc_call("GET", f"{endpoint}/admin/realms/{realm}/users/{uid}/groups", token)
    groups = [g.get("name") for g in json.loads(body or b"[]")] if status == 200 else []
    if group not in groups:
        print(f"user {email} exists but is not in group {group}; groups={groups}")
        sys.exit(1)
    print(f"user {email} exists and is in group {group}")
    sys.exit(0)


def cmd_user_delete(args):
    endpoint, realm, admin_user, admin_pwd = _kc_env()
    email, _ = _lab_user_email(args)
    token = _kc_token(endpoint, admin_user, admin_pwd)
    uid = _kc_user_id(endpoint, realm, token, email)
    if uid is None:
        print(f"no Keycloak user {email}; nothing to delete")
        sys.exit(0)
    status, body = _kc_call("DELETE", f"{endpoint}/admin/realms/{realm}/users/{uid}", token)
    if status not in (204, 404):
        die(3, f"delete user HTTP {status}: {body[:300]!r}")
    print(f"deleted Keycloak user {email}")
    sys.exit(0)


def cmd_user_login_url(args):
    """Print the tenant's Wiz SSO login URL. Author tool: a lab pins this URL as a note literal (it is
    a per-tenant constant, identical for every learner), and regenerates it here when the tenant
    changes — the single source that keeps the literal from silently drifting."""
    url = _wiz_login_url()
    if not url:
        die(3, "cannot build login URL: no SSO entry for tenant or no tid in token")
    print(url)
    sys.exit(0)


# reap: delete a lab user's Wiz footprint from the audit log. Delete is uniform delete<Type>(input:{id})
# across ~34 of 36 create types; correlation (find by name) is per-type — the generic handler
# (plural+search, hard verify) covers the norm, _REAP_OVERRIDES holds the exceptions we measured.
_REAP_OVERRIDES = {
    "ServiceAccount": {"list": "serviceAccounts", "filter": "name", "soft": True},
}

# Types the prefix sweep checks by name. Verified delete<X>({id}) + search/name filter; the
# lease-unique lab-<account> stem is a safe prefix match. Extend as labs create new types.
_SWEEP_TYPES = ["Connector", "Project", "Report", "Control", "SavedGraphQuery",
                "AutomationWorkflow", "ServiceAccount"]


def _plural(x):
    lc = x[0].lower() + x[1:]
    if lc.endswith("y") and lc[-2].lower() not in "aeiou":
        return lc[:-1] + "ies"
    return lc + "s"


def _reap_handler(x):
    o = _REAP_OVERRIDES.get(x, {})
    return {"list": o.get("list", _plural(x)), "filter": o.get("filter", "search"),
            "delete": "delete" + x, "soft": o.get("soft", False)}


def _gql(tok, dc, query):
    # Non-fatal twin of api(): returns (data, errors) so one unresolvable type alerts, not aborts.
    res = _post(f"https://api.{dc}.app.wiz.io/graphql", {"query": query},
                {"Content-Type": "application/json", "Authorization": f"Bearer {tok}"})
    return res.get("data") or {}, res.get("errors") or []


def _input_name(d):
    if isinstance(d, dict):
        for k in ("name", "displayName", "title"):
            if isinstance(d.get(k), str):
                return d[k]
        for v in d.values():
            r = _input_name(v)
            if r:
                return r
    return None


def _reap_enumerate(tok, dc, email, minutes):
    fb = f"actionType: MUTATION, timestamp: {{ inLast: {{ amount: {minutes}, unit: DurationFilterValueUnitMinutes }} }}"
    out, cursor, pages = [], None, 0
    while pages < 30:
        after = f', after: "{cursor}"' if cursor else ""
        qy = ("query { auditLogEntries(first: 100" + after + ", filterBy: { " + fb + " }) "
              "{ nodes { action status performer { name } actionParameters } pageInfo { hasNextPage endCursor } } }")
        data, _ = _gql(tok, dc, qy)
        conn = data.get("auditLogEntries") or {}
        for n in conn.get("nodes") or []:
            if (n.get("performer") or {}).get("name") != email or n.get("status") != "SUCCESS":
                continue
            if n["action"].startswith("Create"):
                out.append((n["action"], _input_name((n.get("actionParameters") or {}).get("input") or {})))
        pi = conn.get("pageInfo") or {}
        if not pi.get("hasNextPage"):
            break
        cursor, pages = pi.get("endCursor"), pages + 1
    return out


def _reap_find(tok, dc, h, name):
    # Returns (id_if_exactly_one, exact_count, error). Exact-name guard is load-bearing: list filters
    # are substring (measured on serviceAccounts.name), so a shared tenant demands ==1 before delete.
    extra = ", deleted: false" if h["soft"] else ""
    qy = ("query { " + h["list"] + "(first: 50, filterBy: { " + h["filter"]
          + ": " + json.dumps(name) + extra + " }) { nodes { id name } } }")
    data, errs = _gql(tok, dc, qy)
    if errs:
        return None, None, errs[0].get("message", "?")
    exact = [n for n in ((data.get(h["list"]) or {}).get("nodes") or []) if n.get("name") == name]
    return (exact[0]["id"] if len(exact) == 1 else None), len(exact), None


def _reap_one(tok, dc, action, name, commit):
    """Reap one caught Create*. Returns (reaped_bool, alert_msg_or_None)."""
    x = action[len("Create"):]
    if not name:
        return False, f"ALERT {action}: no name in input — manual review"
    h = _reap_handler(x)
    rid, count, err = _reap_find(tok, dc, h, name)
    if err:
        return False, f"ALERT {action} {name!r}: no handler ({err})"
    if count != 1:
        return False, f"ALERT {action} {name!r}: matched {count}, need exactly 1 — skipping"
    soft = ", soft" if h["soft"] else ""
    if not commit:
        print(f"DRY-RUN would delete {x} {name!r} ({rid[:8]}{soft})")
        return True, None
    dq = "mutation { " + h["delete"] + '(input: { id: "' + rid + '" }) { _stub } }'
    _d, derr = _gql(tok, dc, dq)
    gone = _reap_find(tok, dc, h, name)[1] == 0
    tail = f" ({derr[0]['message']})" if derr else ""
    print(f"{'deleted' if gone else 'DELETE-FAILED'} {x} {name!r}{tail}")
    return gone, None


def _reap_sweep_type(tok, dc, x, stem, commit):
    """Prefix-sweep one type: delete resources whose name starts with the lease-unique stem. Returns
    (reaped, alerted). Errors (type not searchable this way) are silent — the audit layer covers it."""
    h = _reap_handler(x)
    extra = ", deleted: false" if h["soft"] else ""
    qy = ("query { " + h["list"] + "(first: 100, filterBy: { " + h["filter"]
          + ": " + json.dumps(stem) + extra + " }) { nodes { id name } } }")
    data, errs = _gql(tok, dc, qy)
    if errs:
        return 0, 0
    reaped = alerted = 0
    for n in (data.get(h["list"]) or {}).get("nodes") or []:
        nm = n.get("name") or ""
        if not nm.startswith(stem):
            continue
        if not commit:
            print(f"DRY-RUN would sweep {x} {nm!r} ({n['id'][:8]})")
            reaped += 1
            continue
        _d, derr = _gql(tok, dc, "mutation { " + h["delete"] + '(input: { id: "' + n["id"] + '" }) { _stub } }')
        if derr:
            print(f"SWEEP-FAILED {x} {nm!r}: {derr[0]['message']}")
            alerted += 1
        else:
            print(f"swept {x} {nm!r}")
            reaped += 1
    return reaped, alerted


def cmd_reap(args):
    """Reap a lab session's Wiz footprint. DRY-RUN by default; --commit deletes. Two layers, both
    scoped to the lease (--account/AWS_ACCOUNT_ID): (1) audit-by-actor — SUCCESS Create* by the
    ephemeral user, mapped to delete<Type>({id}) by exact name, catches free-form learner GUI creates;
    (2) prefix sweep — delete any known-type resource named lab-<account>*, catches solve /
    service-account creates the audit layer can't attribute. Best-effort; pair with `user delete`."""
    account = _flag(args, "--account") or os.getenv("AWS_ACCOUNT_ID")
    if not account:
        die(2, "reap needs --account or AWS_ACCOUNT_ID")
    email = _flag(args, "--email") or _lab_user_email(args)[0]
    stem = _lab_stem(account)
    minutes = int(_flag(args, "--last-min") or "1440")
    commit = "--commit" in args
    tok, dc, _ = token_and_dc()
    reaped = alerted = 0
    for action, name in _reap_enumerate(tok, dc, email, minutes):
        did, alert = _reap_one(tok, dc, action, name, commit)
        if alert:
            print(alert)
            alerted += 1
        elif did:
            reaped += 1
    for x in _SWEEP_TYPES:
        r, a = _reap_sweep_type(tok, dc, x, stem, commit)
        reaped += r
        alerted += a
    verb = "reaped" if commit else "to reap (dry-run)"
    print(f"# {reaped} {verb}, {alerted} alert(s) for {email} / {stem}*", file=sys.stderr)
    sys.exit(0)


def _flag(args, name):
    if name not in args:
        return None
    i = args.index(name)
    if i + 1 >= len(args):
        die(2, f"missing value for flag {name}")
    return args[i + 1]


VERBS = {
    ("session", "verify"): cmd_session_verify,
    ("connector", "inspect"): cmd_connector_inspect,
    ("connector", "ensure"): cmd_connector_ensure,
    ("connector", "delete"): cmd_connector_delete,
    ("instance", "inspect"): cmd_instance_inspect,
    ("role", "inspect"): cmd_role_inspect,
    ("role", "ensure"): cmd_role_ensure,
    ("user", "ensure"): cmd_user_ensure,
    ("user", "inspect"): cmd_user_inspect,
    ("user", "delete"): cmd_user_delete,
    ("user", "login-url"): cmd_user_login_url,
    ("wiz", "tenant"): cmd_wiz_tenant,
    ("wiz", "queries"): cmd_wiz_queries,
    ("wiz", "type"): cmd_wiz_type,
    ("audit", "user"): cmd_audit_user,
    ("user", "reap"): cmd_reap,
}


def main():
    if len(sys.argv) < 3 or (sys.argv[1], sys.argv[2]) not in VERBS:
        die(2, f"usage: wizlab {{{' | '.join(' '.join(k) for k in VERBS)}}} [flags]")
    # One structural guard: any uncaught exception is a bug/invocation error (2), never a raw
    # traceback exiting 1 (which a learner check would read as "you're wrong").
    try:
        VERBS[(sys.argv[1], sys.argv[2])](sys.argv[3:])
    except SystemExit:
        raise
    except Exception as e:
        die(2, f"internal error: {type(e).__name__}: {e}")


if __name__ == "__main__":
    main()
