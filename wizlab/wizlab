    ("serviceaccount", "inspect"): cmd_serviceaccount_inspect,
    ("serviceaccount", "delete"): cmd_serviceaccount_delete,
    ("code-scan", "inspect"): cmd_codescan_inspect,
    ("policy", "ensure"): cmd_policy_ensure,
